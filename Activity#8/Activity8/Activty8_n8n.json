    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a helpful weather assistant. Summarize this weather data in a friendly sentence.\n\nTemperature: {{$json[\"temperature\"]}} °C\nHumidity: {{$json[\"humidity\"]}} %\nDate: {{$json[\"currentDate\"]}}\n",

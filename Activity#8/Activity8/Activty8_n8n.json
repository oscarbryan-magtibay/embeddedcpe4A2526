      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        144,
        240
      ],
      "id": "33573701-8b8b-4632-95d0-d0ec5e6273a1",
      "name": "Weather Agent"
    },
    {
      "parameters": {
        "jsCode": "// --- 1. Get AI output ---\nconst aiText = $json[\"text\"] || $json[\"output\"] || \"No summary available\";\n\n// --- 2. Parse date safely ---\nconst inputDateStr = $json[\"currentDate\"] || $json[\"date\"] || new Date();\nconst dateObj = new Date(inputDateStr);\n\n// --- 3. Time and greeting in local time zone (Asia/Manila) ---\nconst timeStr = dateObj.toLocaleTimeString(\"en-US\", {\n  hour: \"2-digit\",\n  minute: \"2-digit\",\n  hour12: false,\n  timeZone: \"Asia/Manila\"\n});\n\nconst hours = parseInt(dateObj.toLocaleString(\"en-US\", {\n  hour: \"2-digit\",\n  hour12: false,\n  timeZone: \"Asia/Manila\"\n}));\n\nlet greeting = \"Good Evening\";\nif (hours < 12) greeting = \"Good Morning\";\nelse if (hours < 18) greeting = \"Good Afternoon\";\n\n// --- 4. Format date in local time zone ---\nconst formattedDate = dateObj.toLocaleDateString(\"en-US\", {\n  year: \"numeric\",\n  month: \"long\",\n  day: \"numeric\",\n  timeZone: \"Asia/Manila\"\n});\n\n// --- 5. Include raw data if exists ---\nconst rawDataStr = $json[\"data\"] || $json[\"input\"] || \"No additional data\";\n\n// --- 6. Build final report ---\nconst finalReport = `${greeting}! Today is ${formattedDate} at ${timeStr}.\nAI Summary: ${aiText}\nRaw Data: ${rawDataStr}`;\n\nreturn [{\n  finalReport\n}];\n"
      },
